      "source": [
        "# 判定する正の整数\n",
        "var = 15\n",
        "\n",
        "# 3と5の両方の倍数を最初に判定する（先に3の倍数を判定すると「Fizz」で止まってしまう）\n",
        "if var % 3 == 0 and var % 5 == 0:\n",
        "    print(\"FizzBuzz\")\n",
        "elif var % 3 == 0:\n",
        "    print(\"Fizz\")\n",
        "elif var % 5 == 0:\n",
        "    print(\"Buzz\")\n",
        "else:\n",
        "    print(var)"
      ]
    }
  ]
}