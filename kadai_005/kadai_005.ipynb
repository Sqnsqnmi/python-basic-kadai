      "source": [
        "# 台形の面積を求める\n",
        "upper_base = 10  # 上辺（cm）\n",
        "lower_base = 20  # 下辺（cm）\n",
        "height = 5  # 高さ（cm）\n",
        "\n",
        "# 公式：（上辺 + 下辺）× 高さ ÷ 2\n",
        "area = (upper_base + lower_base) * height / 2\n",
        "\n",
        "# 数値を文字列に変換して単位と結合する\n",
        "print(str(area) + \"cm²\")"
      ],
      "metadata": {
