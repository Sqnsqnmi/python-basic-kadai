    "# 金額に消費税を加えた結果を返す関数\n",
    "def calculate_price_with_tax(price: int, tax_rate: int) -> float:\n",
    "    # 消費税額（金額 × 税率 ÷ 100）を金額に足して返す\n",
    "    return price + price * tax_rate / 100\n",
    "\n",
    "# 第1引数に商品の金額、第2引数に消費税（%）を渡し、戻り値を受け取る\n",
    "total = calculate_price_with_tax(110, 10)\n",
    "print(total)"
   ]
