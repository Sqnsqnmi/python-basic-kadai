    "price1 = 100  # グローバル変数（関数の中からも読める）\n",
    "price2 = 200\n",
    "\n",
    "def total():\n",
    "    tax = 1.1  # ローカル変数（この関数の中でしか使えない）\n",
    "    # 元のコードは関数の外でtaxを使っていたためNameErrorになっていた\n",
    "    # ローカル変数taxを使う税込みの計算は、関数の中で行って戻り値で返す\n",
    "    return (price1 + price2) * tax\n",
    "\n",
    "print(total())"
   ]
  }
 ]
