      "source": [
        "array = [\"水\", \"金\", \"地\", \"火\", \"木\", \"土\", \"天\", \"海\", \"冥\"]\n",
        "\n",
        "# for文：リストの要素を先頭から1つずつ取り出して出力する\n",
        "for planet in array:\n",
        "    print(planet)\n",
        "\n",
        "# while文：インデックスを0から1ずつ増やし、要素数に達するまで出力する\n",
        "i = 0\n",
        "while i < len(array):\n",
        "    print(array[i])\n",
        "    i += 1"
      ]
